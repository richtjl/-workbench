{
  "name": "self-discipline-workbench",
  "version": "2.0.0",
  "description": "自律工作台 - 专注·任务·习惯·记账·心情·运动",
  "main": "electron-main.js",
  "scripts": {
    "start": "electron .",
    "build-win": "electron-builder --win",
    "build-mac": "electron-builder --mac",
    "build-linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.yourname.workbench",
    "productName": "自律工作台",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron-main.js",
      "index.html",
      "style.css",
      "app.js",
      "chart.umd.min.js",
      "manifest.json",
      "sw.js",
      "companion-aoi.png",
      "icon-*.png",
      "emotions/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon-512.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "icon-512.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "icon-512.png"
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.6.4"
  }
}
